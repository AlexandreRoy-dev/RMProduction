    "green": {
      "value": "#0F4B3A",
      "role": "primary brand green: labels, links, hovers, signature period, logo dot on light"
    },
    "green2": {
      "value": "#1A6B55",
      "role": "gradient partner of green only"
    },
    "greenLight": {
      "value": "#3DA37F",
      "role": "logo dot and period on dark backgrounds (ink or green) only"
    },
    "greenGradient": {
      "value": "linear-gradient(135deg, #0F4B3A 0%, #1A6B55 100%)"
    },
    "ink": {
      "value": "#111111",
      "role": "text, headings, primary buttons, dark sections, logo R"
    },
    "bg": {
      "value": "#F9F9F7"
    },
    "bg2": {
      "value": "#F5F5F3"
    },
    "white": {
      "value": "#FFFFFF"
    },
    "stone": {
      "200": {
        "value": "#E7E5E4"
      },
      "300": {
        "value": "#D6D3D1"
      },
      "400": {
        "value": "#A8A29E"
      },
      "500": {
        "value": "#78716C"
      },
      "600": {
        "value": "#57534E"
      },
      "700": {
        "value": "#44403C"
      },
      "800": {
        "value": "#292524"
      }
    },
    "error": {
      "value": "#DC2626",
      "role": "form validation only"
    }
  },
  "font": {
    "family": {
      "display": {
        "value": "Montserrat",
        "brand": "Gotham (licensed, design and print only, files not shipped)",
        "stack": "\"Montserrat\", \"Gotham\", \"Helvetica Neue\", Arial, sans-serif"
      },
      "body": {
        "value": "Inter",
        "stack": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif"
      }
    },
    "weight": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "size": {
      "label": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lead": "1.125rem",
      "xl": "1.25rem",
      "h4": "1.5rem",
      "h3": "1.875rem",
      "h2": "clamp(2rem, 1.4rem + 2.4vw, 3rem)",
      "h1": "clamp(2.75rem, 1.6rem + 4.6vw, 4.5rem)",
      "display": "clamp(3.5rem, 2rem + 6vw, 6rem)"
    },
    "lineHeight": {
      "hero": 0.95,
      "tight": 1.1,
      "snug": 1.3,
      "body": 1.6
    },
    "letterSpacing": {
      "hero": "-0.025em",
      "label": "0.15em",
      "wordmark": "0.1em"
    }
  },
  "textStyle": {
    "hero": {
      "family": "display",
      "weight": 500,
      "weightLastLine": 700,
      "size": "h1",
      "lineHeight": 0.95,
      "letterSpacing": "-0.025em",
      "transform": "uppercase"
    },
    "h2": {
      "family": "display",
      "weight": 500,
      "size": "h2",
      "lineHeight": 1.1
    },
    "label": {
      "family": "body",
      "weight": 700,
      "size": "label",
      "letterSpacing": "0.15em",
      "transform": "uppercase",
      "color": "green"
    },
    "lead": {
      "family": "body",
      "weight": 300,
      "size": "lead",
      "lineHeight": 1.6,
      "color": "stone.600"
    },
    "wordmark": {
      "family": "display",
      "weight": 700,
      "letterSpacing": "0.1em",
      "transform": "uppercase",
      "color": "ink",
      "periodColor": "green"
    },
    "button": {
      "family": "body",
      "weight": 700,
      "size": "label",
      "letterSpacing": "0.1em",
      "transform": "uppercase",
      "color": "white",
      "background": "ink",
      "hoverBackground": "green",
      "padding": "20px 48px",
      "radius": 0
    }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "24": "6rem",
