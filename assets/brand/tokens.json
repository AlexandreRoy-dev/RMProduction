  "radius": {
    "default": "0",
    "dot": "9999px"
  },
  "shadow": {
    "green": "0 12px 32px -12px rgba(15, 75, 58, 0.35)"
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
